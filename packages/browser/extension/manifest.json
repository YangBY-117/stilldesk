{
  "manifest_version": 3,
  "name": "StillDesk Browser",
  "version": "0.2.0",
  "description": "Background-first agent tools for Chrome and Edge through Native Messaging.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs",
    "webNavigation",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "StillDesk Browser: Native Messaging bridge"
  },
  "key": ""
}
